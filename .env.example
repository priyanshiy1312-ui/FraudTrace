# Copy to .env  (cp .env.example .env)  and fill in ONE key. .env is git-ignored.
# The provider is detected from whichever key is set (order: Groq, Gemini, OpenRouter, Anthropic).

# --- Free option (no credit card): Groq - https://console.groq.com/keys ---
GROQ_API_KEY=
# Optional: LLM_MODEL=openai/gpt-oss-120b   (try llama-3.3-70b-versatile if tool calls are flaky)

# --- Other providers (leave empty if unused) ---

# Any other OpenAI-compatible API: LLM_PROVIDER=openai_compat, LLM_BASE_URL=..., LLM_API_KEY=..., LLM_MODEL=...
# LLM_PROVIDER=

